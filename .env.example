# BTR — Local Development Environment
# Copy to .env.local for local development:  cp .env.example .env.local
# Docker Compose uses its own env settings in docker-compose.yml

# Database (local dev uses Dockerised Postgres on host port 5433)
# Set POSTGRES_PASSWORD first, then build DATABASE_URL from it.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://btr:${POSTGRES_PASSWORD}@localhost:5433/btr

# LLM backend: mock | gemini
LLM_BACKEND=gemini

# File upload directory
UPLOAD_DIR=./uploads

# UI proxy target (Express forwards /api/* here)
API_URL=http://localhost:8000
